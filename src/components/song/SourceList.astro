---
import { useTranslations } from '../../i18n/utils';
import type { SupportedLanguage } from '../../i18n/ui';
import GlossButton from '../ui/GlossButton.astro';

interface SourceItem {
  label?: string;
  title?: string;
  url?: string;
  publisher?: string;
  accessedAt?: string;
  note?: string;
}

interface ListenLinks {
  spotify?: string;
  appleMusic?: string;
  youtube?: string;
}

interface Props {
  sources?: SourceItem[];
  listenLinks?: ListenLinks;
  lang: SupportedLanguage;
  class?: string;
}

const { sources = [], listenLinks, lang, class: className = '' } = Astro.props;
const t = useTranslations(lang);
---

<div class:list={['sources-section', className]}>
  {listenLinks && (listenLinks.spotify || listenLinks.appleMusic || listenLinks.youtube) && (
    <div class="listen-box">
      <div class="listen-header">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <circle cx="12" cy="12" r="10"></circle>
          <polygon points="10 8 16 12 10 16 10 8" fill="currentColor"></polygon>
        </svg>
        <h4>{t('article.listenTitle')}</h4>
      </div>
      <div class="listen-links">
        {listenLinks.spotify && (
          <GlossButton href={listenLinks.spotify} target="_blank" variant="secondary" class="listen-btn">
            Spotify
          </GlossButton>
        )}
        {listenLinks.appleMusic && (
          <GlossButton href={listenLinks.appleMusic} target="_blank" variant="secondary" class="listen-btn">
            Apple Music
          </GlossButton>
        )}
        {listenLinks.youtube && (
          <GlossButton href={listenLinks.youtube} target="_blank" variant="secondary" class="listen-btn">
            YouTube
          </GlossButton>
        )}
      </div>
    </div>
  )}

  {sources.length > 0 && (
    <div class="sources-box">
      <div class="sources-header">
        <h4 class="sources-title">{t('article.sourcesTitle')}</h4>
        <p class="sources-subtitle">{t('article.sourcesSubtitle')}</p>
      </div>
      <ul class="sources-list">
        {sources.map((source) => (
          <li class="source-item">
            <span class="source-bullet" aria-hidden="true">•</span>
            <div class="source-content">
              {source.url ? (
                <a href={source.url} target="_blank" rel="noopener noreferrer" class="source-link">
                  {source.label || source.title}
                </a>
              ) : (
                <span class="source-title-text">{source.label || source.title}</span>
              )}
              {source.publisher && (
                <p class="source-publisher-text">
                  {source.publisher}{source.accessedAt ? ` • ${source.accessedAt}` : ''}
                </p>
              )}
              {source.note && <p class="source-note">{source.note}</p>}
            </div>
          </li>
        ))}
      </ul>
    </div>
  )}
</div>

<style>
  .sources-section {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
    margin-top: var(--space-12);
    padding-top: var(--space-8);
    border-top: 1px solid var(--color-line);
  }

  .listen-box {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    background: var(--color-white);
    padding: var(--space-4) var(--space-6);
    border-radius: var(--radius-md);
    border: 1px solid var(--color-line);
    box-shadow: 0 2px 8px rgb(16 55 71 / 4%);
  }

  .listen-header {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--color-blue-900);
    font-weight: 700;
    font-size: var(--text-sm);
  }

  .listen-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .listen-btn {
    font-size: var(--text-xs);
    padding: var(--space-2) var(--space-4);
  }

  .sources-box {
    background: var(--color-white);
    padding: var(--space-6) var(--space-6);
    border-radius: var(--radius-md);
    border: 1px solid var(--color-line);
  }

  .sources-header {
    margin-bottom: var(--space-4);
  }

  .sources-title {
    font-size: var(--text-base);
    font-weight: 700;
    color: var(--color-ink);
  }

  .sources-subtitle {
    font-size: var(--text-xs);
    color: var(--color-ink-muted);
    margin-top: 2px;
  }

  .sources-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .source-item {
    display: flex;
    align-items: flex-start;
    gap: var(--space-2);
    font-size: var(--text-sm);
  }

  .source-bullet {
    color: var(--color-aqua-500);
    font-weight: 700;
  }

  .source-content {
    display: flex;
    flex-direction: column;
  }

  .source-link {
    color: var(--color-blue-700);
    font-weight: 600;
    text-decoration: underline;
  }

  .source-title-text {
    font-weight: 600;
    color: var(--color-ink);
  }

  .source-publisher-text {
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    color: var(--color-amber-700);
    font-weight: 600;
    margin-top: 1px;
  }

  .source-note {
    font-size: var(--text-xs);
    color: var(--color-ink-muted);
    margin-top: 2px;
  }
</style>
