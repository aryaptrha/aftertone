---
interface Props {
  summary: string;
  title?: string;
  subtitle?: string;
  class?: string;
}

const {
  summary,
  title = 'The Song, in a Minute',
  subtitle = 'Ringkasan Inti Interpretasi',
  class: className = '',
} = Astro.props;
---

<div class:list={['interpretation-summary', className]}>
  <div class="summary-badge">
    <span class="badge-gem" aria-hidden="true"></span>
    <span class="badge-title">{title}</span>
    {subtitle && <span class="badge-sub">• {subtitle}</span>}
  </div>
  <p class="summary-text">{summary}</p>
</div>

<style>
  .interpretation-summary {
    position: relative;
    padding: var(--space-6) var(--space-8);
    background:
      linear-gradient(
        180deg,
        rgb(255 255 255 / 90%) 0%,
        rgb(255 255 255 / 40%) 20%,
        transparent 60%
      ),
      linear-gradient(135deg, var(--color-aqua-100), var(--color-mint-100));
    border: 1px solid rgb(56 200 217 / 35%);
    border-radius: var(--radius-lg);
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 90%),
      var(--shadow-card);
    margin-block: var(--space-8);
  }

  .summary-badge {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-blue-900);
    margin-bottom: var(--space-3);
  }

  .badge-gem {
    width: 8px;
    height: 8px;
    border-radius: 2px;
    background: var(--color-orange-500);
    box-shadow: 0 0 6px rgb(255 120 62 / 60%);
  }

  .badge-sub {
    color: var(--color-ink-muted);
    font-weight: 600;
    text-transform: none;
    letter-spacing: normal;
  }

  .summary-text {
    font-size: var(--text-lg);
    font-weight: 500;
    line-height: 1.65;
    color: var(--color-ink);
    letter-spacing: -0.01em;
  }

  @media (max-width: 640px) {
    .interpretation-summary {
      padding: var(--space-5) var(--space-5);
    }

    .summary-text {
      font-size: var(--text-base);
    }
  }
</style>
