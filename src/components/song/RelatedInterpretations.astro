---
import { useTranslations } from '../../i18n/utils';
import type { SupportedLanguage } from '../../i18n/ui';
import ThemeTag from '../ui/ThemeTag.astro';
import { getThemeLabel } from '../../data/themes';
import type { Article } from '../../data/articles';

interface Props {
  songs: Article[];
  lang: SupportedLanguage;
  class?: string;
}

const { songs, lang, class: className = '' } = Astro.props;
const t = useTranslations(lang);

if (songs.length === 0) {
  return null;
}
---

<section class:list={['related-section', className]} aria-labelledby="related-title">
  <div class="related-header">
    <div class="gem-badge" aria-hidden="true"></div>
    <div>
      <h3 id="related-title" class="related-title">{t('article.relatedTitle')}</h3>
      <p class="related-subtitle">{t('article.relatedSubtitle')}</p>
    </div>
  </div>

  <div class="related-grid">
    {
      songs.map((item) => {
        const href = `/${lang}/songs/${item.data.slug}/`;
        return (
          <article class="compact-card">
            <div class="compact-card__tags">
              {item.data.themes.slice(0, 1).map((theme) => (
                <ThemeTag label={getThemeLabel(theme, lang)} />
              ))}
            </div>
            <h4 class="compact-card__title">
              <a href={href}>{item.data.title}</a>
            </h4>
            <p class="compact-card__artist">
              {t('song.by')} <strong>{item.data.artist}</strong>
            </p>
            <p class="compact-card__summary">{item.data.summary}</p>
            <div class="compact-card__footer">
              <a href={href} class="compact-link">
                <span>{t('song.read')}</span>
                <svg width="12" height="12" viewBox="0 0 16 16" fill="none">
                  <path
                    d="M3.333 8h9.334M8 3.333L12.667 8 8 12.667"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
              </a>
            </div>
          </article>
        );
      })
    }
  </div>
</section>

<style>
  .related-section {
    margin-top: var(--space-12);
    padding-top: var(--space-8);
    border-top: 1px solid var(--color-line);
  }

  .related-header {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-bottom: var(--space-6);
  }

  .gem-badge {
    width: 10px;
    height: 10px;
    background: var(--color-orange-500);
    border-radius: 2px;
    box-shadow: 0 0 8px rgb(255 120 62 / 60%);
  }

  .related-title {
    font-size: var(--text-xl);
    font-weight: 700;
    color: var(--color-ink);
  }

  .related-subtitle {
    font-size: var(--text-xs);
    color: var(--color-ink-muted);
  }

  .related-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(18rem, 1fr));
    gap: var(--space-4);
  }

  .compact-card {
    background: var(--color-white);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-md);
    padding: var(--space-5);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    box-shadow: var(--shadow-card);
    transition:
      transform var(--motion-fast) var(--ease-standard),
      box-shadow var(--motion-fast) var(--ease-standard),
      border-color var(--motion-fast) var(--ease-standard);
  }

  .compact-card:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-raised);
    border-color: var(--color-aqua-500);
  }

  .compact-card__tags {
    margin-bottom: var(--space-1);
  }

  .compact-card__title {
    font-size: var(--text-base);
    font-weight: 700;
    line-height: var(--leading-heading);
  }

  .compact-card__title a {
    color: var(--color-ink);
    text-decoration: none;
  }

  .compact-card__title a:hover {
    color: var(--color-blue-700);
  }

  .compact-card__artist {
    font-size: var(--text-xs);
    color: var(--color-ink-muted);
  }

  .compact-card__summary {
    font-size: var(--text-xs);
    color: var(--color-ink-muted);
    line-height: 1.5;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    margin-top: var(--space-1);
    flex-grow: 1;
  }

  .compact-card__footer {
    margin-top: var(--space-3);
    padding-top: var(--space-2);
    border-top: 1px solid var(--color-line);
  }

  .compact-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    font-size: var(--text-xs);
    font-weight: 700;
    color: var(--color-blue-700);
    text-decoration: none;
  }

  .compact-link:hover {
    color: var(--color-blue-900);
    text-decoration: underline;
  }
</style>
