---
interface Props {
  label: string;
  href?: string;
  active?: boolean;
  count?: number;
  class?: string;
  [key: string]: any;
}

const {
  label,
  href,
  active = false,
  count,
  class: className = '',
  ...rest
} = Astro.props;

const TagElement = href ? 'a' : 'span';
---

<TagElement
  href={href}
  class:list={[
    'theme-tag',
    { 'theme-tag--active': active, 'theme-tag--interactive': Boolean(href) },
    className,
  ]}
  {...rest}
>
  <span class="theme-tag__dot" aria-hidden="true"></span>
  <span class="theme-tag__label">{label}</span>
  {count !== undefined && <span class="theme-tag__count">({count})</span>}
</TagElement>

<style>
  .theme-tag {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: calc(var(--space-1) * 1.2) var(--space-3);
    font-size: var(--text-xs);
    font-weight: 600;
    line-height: 1;
    color: var(--color-ink-muted);
    background: var(--color-white);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-xs);
    box-shadow: 0 1px 3px rgb(16 55 71 / 4%);
    text-decoration: none;
    transition:
      transform var(--motion-fast) var(--ease-standard),
      border-color var(--motion-fast) var(--ease-standard),
      color var(--motion-fast) var(--ease-standard),
      background-color var(--motion-fast) var(--ease-standard),
      box-shadow var(--motion-fast) var(--ease-standard);
    user-select: none;
    white-space: nowrap;
  }

  .theme-tag__dot {
    width: 6px;
    height: 6px;
    border-radius: 1px;
    background: var(--color-aqua-500);
    box-shadow: 0 0 6px rgb(56 200 217 / 60%);
    flex-shrink: 0;
  }

  .theme-tag--interactive:hover {
    transform: translateY(-1px);
    color: var(--color-blue-900);
    border-color: var(--color-aqua-500);
    background: var(--color-aqua-100);
    box-shadow: var(--shadow-gloss);
  }

  .theme-tag--active {
    color: var(--color-blue-900);
    background: var(--color-aqua-200);
    border-color: var(--color-blue-700);
    box-shadow: var(--shadow-gloss);
  }

  .theme-tag--active .theme-tag__dot {
    background: var(--color-orange-500);
    box-shadow: 0 0 6px rgb(255 120 62 / 70%);
  }

  .theme-tag__count {
    opacity: 0.7;
    font-size: 0.7rem;
    font-weight: 500;
  }
</style>
