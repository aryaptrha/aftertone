---
import type { SupportedLanguage } from '../../i18n/ui';
import { useTranslations } from '../../i18n/utils';

interface Props {
  totalPages: number;
  currentPage?: number;
  totalItems: number;
  pageSize?: number;
  lang: SupportedLanguage;
  targetGridId: string;
  sectionId?: string;
  urlParam?: string;
  id?: string;
  class?: string;
}

const {
  totalPages,
  currentPage = 1,
  totalItems,
  pageSize = 6,
  lang,
  targetGridId,
  sectionId = 'archive-crate',
  urlParam = 'page',
  id = 'crate-pagination',
  class: className = '',
} = Astro.props;

const t = useTranslations(lang);

// Pre-calculate initial telemetry range for SSR
const initialStart = totalItems > 0 ? (currentPage - 1) * pageSize + 1 : 0;
const initialEnd = Math.min(currentPage * pageSize, totalItems);

// Generate page numbers array for SSR
function getPageArray(total: number) {
  return Array.from({ length: total }, (_, i) => i + 1);
}
const pages = getPageArray(totalPages);
---

{
  totalPages > 1 && (
    <div
      id={id}
      class:list={['pagination-deck', className]}
      data-pagination-deck
      data-target-grid={targetGridId}
      data-section-id={sectionId}
      data-total-pages={totalPages}
      data-total-items={totalItems}
      data-page-size={pageSize}
      data-url-param={urlParam}
      data-lang={lang}
    >
      <!-- Telemetry Status Bar -->
      <div class="pagination-telemetry">
        <span class="telemetry-chip">
          <span class="telemetry-pip" aria-hidden="true"></span>
          <span>{t('pagination.compartment')}</span>
        </span>
        <span
          class="telemetry-status"
          data-telemetry-text
          aria-live="polite"
        >
          {lang === 'id' ? (
            <>
              {t('pagination.page')} {currentPage} {t('pagination.of')} {totalPages} // {t('pagination.showing')}{' '}
              {initialStart}{t('pagination.to')}{initialEnd} {t('pagination.of')} {totalItems}{' '}
              {t('pagination.records')}
            </>
          ) : (
            <>
              {t('pagination.page')} {currentPage} {t('pagination.of')} {totalPages} // {t('pagination.showing')}{' '}
              {initialStart}{t('pagination.to')}{initialEnd} {t('pagination.of')} {totalItems}{' '}
              {t('pagination.records')}
            </>
          )}
        </span>
      </div>

      <!-- Tactical Controls -->
      <nav class="pagination-nav" aria-label={t('pagination.navLabel')}>
        <button
          type="button"
          class="pagination-btn pagination-btn--prev"
          data-page-btn="prev"
          disabled={currentPage === 1}
          aria-disabled={currentPage === 1 ? 'true' : 'false'}
          aria-label={t('pagination.previous')}
        >
          <svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path
              d="M10 12L6 8L10 4"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>
          <span class="btn-text">{t('pagination.previous')}</span>
        </button>

        <div
          class="pagination-pages"
          data-pages-container
          role="group"
          aria-label={lang === 'id' ? 'Nomor Halaman' : 'Page Numbers'}
        >
          {pages.map((p) => (
            <button
              type="button"
              class:list={['pagination-num', { 'pagination-num--active': p === currentPage }]}
              data-page-num={p}
              aria-label={`${t('pagination.page')} ${p}`}
              aria-current={p === currentPage ? 'page' : undefined}
            >
              {p}
            </button>
          ))}
        </div>

        <button
          type="button"
          class="pagination-btn pagination-btn--next"
          data-page-btn="next"
          disabled={currentPage === totalPages}
          aria-disabled={currentPage === totalPages ? 'true' : 'false'}
          aria-label={t('pagination.next')}
        >
          <span class="btn-text">{t('pagination.next')}</span>
          <svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path
              d="M6 4L10 8L6 12"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>
        </button>
      </nav>
    </div>
  )
}

<script>
  function initPagination() {
    const decks = document.querySelectorAll<HTMLElement>('[data-pagination-deck]');

    decks.forEach((deck) => {
      // Prevent multiple initializations on the same deck
      if (deck.dataset.initialized === 'true') return;
      deck.dataset.initialized = 'true';

      const targetGridId = deck.dataset.targetGrid;
      const sectionId = deck.dataset.sectionId;
      const totalPages = parseInt(deck.dataset.totalPages || '1', 10);
      const totalItems = parseInt(deck.dataset.totalItems || '0', 10);
      const pageSize = parseInt(deck.dataset.pageSize || '6', 10);
      const urlParam = deck.dataset.urlParam || 'page';
      const lang = deck.dataset.lang || 'id';

      const grid = targetGridId ? document.getElementById(targetGridId) : null;
      if (!grid) return;

      const cards = Array.from(grid.querySelectorAll<HTMLElement>(':scope > .sleeve-card'));
      const prevBtn = deck.querySelector<HTMLButtonElement>('[data-page-btn="prev"]');
      const nextBtn = deck.querySelector<HTMLButtonElement>('[data-page-btn="next"]');
      const pagesContainer = deck.querySelector<HTMLElement>('[data-pages-container]');
      const telemetryText = deck.querySelector<HTMLElement>('[data-telemetry-text]');

      // Tag all cards with their respective page numbers (1-indexed)
      cards.forEach((card, index) => {
        const page = Math.floor(index / pageSize) + 1;
        card.setAttribute('data-page', page.toString());
      });

      // Enable paginated mode on the grid container
      grid.setAttribute('data-paginated', 'true');

      // Determine initial page from URL param or default 1
      function getPageFromUrl(): number {
        const params = new URLSearchParams(window.location.search);
        const parsed = parseInt(params.get(urlParam) || '1', 10);
        if (Number.isFinite(parsed) && parsed >= 1 && parsed <= totalPages) {
          return parsed;
        }
        return 1;
      }

      let activePage = getPageFromUrl();

      function formatTelemetry(page: number): string {
        const start = totalItems > 0 ? (page - 1) * pageSize + 1 : 0;
        const end = Math.min(page * pageSize, totalItems);

        if (lang === 'id') {
          return `Halaman ${page} dari ${totalPages} // Menampilkan ${start}–${end} dari ${totalItems} rekaman`;
        }
        return `Page ${page} of ${totalPages} // Showing ${start}–${end} of ${totalItems} records`;
      }

      function renderPaginationControls(page: number) {
        // Update cards visibility
        cards.forEach((card) => {
          const cardPage = parseInt(card.getAttribute('data-page') || '1', 10);
          const isVisible = cardPage === page;
          card.setAttribute('data-page-active', isVisible ? 'true' : 'false');
          if (isVisible) {
            card.removeAttribute('hidden');
            card.style.display = '';
          } else {
            card.setAttribute('hidden', '');
            card.style.display = 'none';
          }
        });

        // Update Prev / Next buttons
        if (prevBtn) {
          const isFirst = page <= 1;
          prevBtn.disabled = isFirst;
          prevBtn.setAttribute('aria-disabled', isFirst ? 'true' : 'false');
        }

        if (nextBtn) {
          const isLast = page >= totalPages;
          nextBtn.disabled = isLast;
          nextBtn.setAttribute('aria-disabled', isLast ? 'true' : 'false');
        }

        // Update Page Number Buttons
        if (pagesContainer) {
          const pageButtons = pagesContainer.querySelectorAll<HTMLButtonElement>('[data-page-num]');
          pageButtons.forEach((btn) => {
            const btnPage = parseInt(btn.dataset.pageNum || '1', 10);
            const isActive = btnPage === page;
            btn.classList.toggle('pagination-num--active', isActive);
            if (isActive) {
              btn.setAttribute('aria-current', 'page');
            } else {
              btn.removeAttribute('aria-current');
            }
          });
        }

        // Update Telemetry Text
        if (telemetryText) {
          telemetryText.textContent = formatTelemetry(page);
        }
      }

      function goToPage(targetPage: number, updateUrl = true, shouldScroll = true) {
        const clamped = Math.max(1, Math.min(targetPage, totalPages));
        if (clamped === activePage && updateUrl) return;

        activePage = clamped;
        renderPaginationControls(activePage);

        if (updateUrl && window.history.pushState) {
          const currentUrl = new URL(window.location.href);
          if (activePage === 1) {
            currentUrl.searchParams.delete(urlParam);
          } else {
            currentUrl.searchParams.set(urlParam, activePage.toString());
          }
          window.history.pushState({ page: activePage }, '', currentUrl.toString());
        }

        if (shouldScroll && sectionId) {
          const section = document.getElementById(sectionId);
          if (section) {
            const rect = section.getBoundingClientRect();
            // Scroll up only if the top of the archive section has scrolled above the viewport
            if (rect.top < -20) {
              section.scrollIntoView({ behavior: 'smooth', block: 'start' });
            }
          }
        }
      }

      // Event Listeners for Prev and Next buttons
      if (prevBtn) {
        prevBtn.addEventListener('click', () => {
          if (activePage > 1) {
            goToPage(activePage - 1);
          }
        });
      }

      if (nextBtn) {
        nextBtn.addEventListener('click', () => {
          if (activePage < totalPages) {
            goToPage(activePage + 1);
          }
        });
      }

      // Event Listener for Page Number clicks (using delegation)
      if (pagesContainer) {
        pagesContainer.addEventListener('click', (e) => {
          const target = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-page-num]');
          if (target && target.dataset.pageNum) {
            const num = parseInt(target.dataset.pageNum, 10);
            if (!Number.isNaN(num)) {
              goToPage(num);
            }
          }
        });
      }

      // Handle browser back and forward button navigation
      window.addEventListener('popstate', () => {
        const urlPage = getPageFromUrl();
        if (urlPage !== activePage) {
          goToPage(urlPage, false, false);
        }
      });

      // Initialize state on first run
      renderPaginationControls(activePage);
    });
  }

  // Initialize on script load and DOM ready
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initPagination);
  } else {
    initPagination();
  }
</script>

<style>
  .pagination-deck {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--space-4);
    padding: var(--space-4) var(--space-6);
    background:
      linear-gradient(180deg,
        rgb(255 255 255 / 96%) 0%,
        rgb(238 252 253 / 88%) 100%
      );
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-btn);
    margin-top: var(--space-10);
    position: relative;
    user-select: none;
  }

  .pagination-telemetry {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    flex-wrap: wrap;
  }

  .telemetry-chip {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-weight: 700;
    color: var(--color-blue-900);
    letter-spacing: 0.08em;
    background: rgb(56 200 217 / 12%);
    padding: 3px 8px;
    border-radius: var(--radius-xs);
    border: 1px solid rgb(56 200 217 / 30%);
  }

  .telemetry-pip {
    width: 5px;
    height: 5px;
    border-radius: 1px;
    background: var(--color-amber-500);
    box-shadow: 0 0 6px rgb(255 123 57 / 80%);
  }

  .telemetry-status {
    color: var(--color-ink-muted);
    font-weight: 600;
    letter-spacing: 0.04em;
  }

  .pagination-nav {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
  }

  .pagination-btn {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: 6px 12px;
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    font-weight: 700;
    letter-spacing: 0.05em;
    color: var(--color-blue-900);
    background: var(--color-sleeve);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xs);
    cursor: pointer;
    transition:
      background var(--motion-fast) var(--ease-tactile),
      color var(--motion-fast) var(--ease-tactile),
      border-color var(--motion-fast) var(--ease-tactile),
      transform var(--motion-fast) var(--ease-tactile),
      box-shadow var(--motion-fast) var(--ease-tactile);
    box-shadow: var(--shadow-btn);
  }

  .pagination-btn:hover:not(:disabled) {
    color: var(--color-blue-900);
    border-color: var(--color-blue-700);
    background: var(--color-aqua-100);
    transform: translateY(-1px);
    box-shadow: var(--shadow-btn-hover);
  }

  .pagination-btn:active:not(:disabled) {
    transform: translateY(1px);
    box-shadow: var(--shadow-pressed);
  }

  .pagination-btn:disabled {
    opacity: 0.4;
    cursor: not-allowed;
    border-color: var(--color-border);
    background: var(--color-canvas);
    color: var(--color-ink-muted);
    box-shadow: none;
    transform: none;
  }

  .pagination-pages {
    display: inline-flex;
    align-items: center;
    gap: 4px;
  }

  .pagination-num {
    min-width: 32px;
    height: 32px;
    padding: 0 8px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    font-weight: 700;
    color: var(--color-ink-muted);
    background: var(--color-sleeve);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xs);
    cursor: pointer;
    transition:
      background var(--motion-fast) var(--ease-tactile),
      color var(--motion-fast) var(--ease-tactile),
      border-color var(--motion-fast) var(--ease-tactile),
      transform var(--motion-fast) var(--ease-tactile),
      box-shadow var(--motion-fast) var(--ease-tactile);
    box-shadow: var(--shadow-btn);
  }

  .pagination-num:hover:not(.pagination-num--active) {
    color: var(--color-blue-900);
    border-color: var(--color-aqua-500);
    background: var(--color-aqua-50);
    transform: translateY(-1px);
  }

  .pagination-num:active:not(.pagination-num--active) {
    transform: translateY(1px);
  }

  .pagination-num--active {
    color: var(--color-sleeve);
    background: var(--color-blue-900);
    border-color: var(--color-blue-900);
    box-shadow: 0 0 0 1px var(--color-blue-900), 0 2px 6px rgb(16 59 82 / 20%);
    font-weight: 800;
    cursor: default;
  }

  @media (max-width: 768px) {
    .pagination-deck {
      flex-direction: column;
      align-items: stretch;
      text-align: center;
      padding: var(--space-4);
      gap: var(--space-3);
    }

    .pagination-telemetry {
      justify-content: center;
    }

    .pagination-nav {
      justify-content: center;
      flex-wrap: wrap;
    }
  }

  @media (max-width: 480px) {
    .pagination-btn .btn-text {
      display: none;
    }

    .pagination-btn {
      padding: 6px 8px;
    }
  }
</style>
